# Rename this file to vault.env inside your org/ directory (gitignored).
# Sourced into all login shells as /etc/profile.d/vault.sh at container startup.
#
# install-vault.sh puts the binary at /root/.local/bin — add it to PATH here.

export PATH="/root/.local/bin:$PATH"
export VAULT_ADDR=http://172.16.5.60:6005
export VAULT_TOKEN_FILE=/root/.vault-token
